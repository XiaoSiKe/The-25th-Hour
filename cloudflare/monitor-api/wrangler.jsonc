{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "25thgame-monitor-api",
  "main": "src/index.js",
  "compatibility_date": "2026-06-18",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://arch.25thgame.vip"
  },
  "routes": [
    {
      "pattern": "world.25thgame.vip/*",
      "zone_name": "25thgame.vip"
    }
  ],
  // Optional hardening: set with `wrangler secret put LEADERBOARD_WRITE_TOKEN`.
  // When configured, public score_submit events still record telemetry but only
  // requests with X-Leaderboard-Write-Token can write player_scores.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "25thgame-monitor",
      "database_id": "00f8de16-3e9e-405d-8277-c3026288e394",
      "migrations_dir": "migrations"
    }
  ]
}
